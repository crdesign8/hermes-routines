{
  "name": "hermes-routines",
  "version": "0.1.0",
  "description": "hermes-routines standalone Desktop plugin (routes + cron pins)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-generated": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:allowlist": "node scripts/check-allowlist.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run typecheck && node scripts/check-allowlist.mjs && node scripts/check-version.mjs && node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "@esbuild/linux-x64": "^0.28.2"
  }
}
